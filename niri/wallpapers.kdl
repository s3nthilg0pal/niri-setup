// awww is optional; the workspace wallpaper works with Fedora's swaybg.
spawn-sh-at-startup "$NIRICONF/scripts/start-backdrop.sh"
spawn-sh-at-startup "swaybg -i $NIRICONF/wallpapers/workspace.jpg -m fill -c '#010102'"
layer-rule {
    match namespace="^awww-daemon$"
    place-within-backdrop true
}
